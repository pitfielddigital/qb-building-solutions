---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { Content, getHeadings } from '../content/privacy-policy.md';
import pages from '../data/pages.json';
const headings = await getHeadings();
---
<BaseLayout {...pages.privacy} noindex>
  <Hero {...pages.privacy} />
  <section><div class="section-inner">
    <div class="policy-layout"><nav aria-label="Privacy policy contents" class="policy-contents"><h2>On this page</h2><ol>{headings.map(({slug,text})=><li><a href={`#${slug}`}>{text.replace(/^\d+\. /,'')}</a></li>)}</ol></nav><article class="prose policy-copy"><Content /></article></div>
  </div></section>
</BaseLayout>
