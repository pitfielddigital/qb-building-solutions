---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import pages from '../data/pages.json';
import { href } from '../lib/urls';
const links = [
  ['Home','Get to know QB Building Solutions and the work we do.','/'],
  ['Our services','Find building, joinery, groundworks and demolition services.','/services/'],
  ['Projects','Ask about examples of work relevant to your plans.','/projects/'],
  ['Contact','Speak to our team about your project.','/contact/'],
];
---
<BaseLayout {...pages.error} noindex>
  <Hero {...pages.error} banner="404"><a class="btn btn-red" href={href('/')}>Return home</a></Hero>
  <section><div class="section-inner"><h2>Where would you like to go?</h2><div class="grid grid-4 service-cards">{links.map(([title,text,url])=><a class="card text-card" href={href(url)}><div class="content"><h3 class="title">{title}</h3><p class="card-text">{text}</p><span class="card-button">Explore <span aria-hidden="true">→</span></span></div></a>)}</div></div></section>
</BaseLayout>
